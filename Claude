/* ═══════════════════════════════════════════════════════════════
   7. SLIDERS (capped: you cannot exceed 10 days; no hidden auto-adjustment)
   ═══════════════════════════════════════════════════════════════ */
const slidersActive = () => state.phase==='explore' || state.phase==='decide';
function buildSliders(){
  $('sliders').innerHTML = BUCKETS.map(b=>`
    <div class="slider-group">
      <span class="slider-group-label"><span class="label-icon">${b.icon}</span>${b.label()}</span>
      <div class="slider-row"><span class="slider-end-label">0</span>
        <div class="slider-track-wrap" id="trk_${b.key}">
          <div class="slider-badge" id="bdg_${b.key}"></div>
          <div class="slider-track-bg"><div class="slider-track-fill" id="fil_${b.key}"></div><div class="slider-thumb" id="thm_${b.key}"></div></div>
        </div><span class="slider-end-label">10</span></div>
    </div>`).join('');
  KEYS.forEach(attachSlider);
}
function attachSlider(key){
  const track=$('trk_'+key); let dragging=false;
  const val = x => { const r=track.getBoundingClientRect(); return Math.max(0,Math.min(CFG.TOTAL_DAYS,Math.round((x-r.left)/r.width*CFG.TOTAL_DAYS))); };
  const apply = v => {
    if (!slidersActive()) return;
    const max = CFG.TOTAL_DAYS - (totalDays() - state.alloc[key]);
    const c = Math.min(v, max);
    if (v > max) $('capHint').textContent = `All ${CFG.TOTAL_DAYS} days are used. Reduce another activity first.`;
    if (c === state.alloc[key]) return;
    if (v <= max) $('capHint').textContent = '';
    const dir = Math.sign(c - state.alloc[key]);
    if (state.lastDir[key] && dir !== state.lastDir[key]) state.reversals++;
    state.lastDir[key] = dir; state.alloc[key] = c; recordMove();
  };
  track.addEventListener('pointerdown', e=>{ if(!slidersActive()) return; dragging=true; try{track.setPointerCapture(e.pointerId);}catch(_){} apply(val(e.clientX)); });
  track.addEventListener('pointermove', e=>{ if(dragging) apply(val(e.clientX)); });
  const end = e=>{ if(!dragging) return; dragging=false; try{track.releasePointerCapture(e.pointerId);}catch(_){} };
  track.addEventListener('pointerup', end); track.addEventListener('pointercancel', end);
}
function refreshSliders(){
  KEYS.forEach(k=>{ const v=state.alloc[k], pct=v/CFG.TOTAL_DAYS*100;
    $('fil_'+k).style.width=pct+'%'; $('thm_'+k).style.left=pct+'%'; $('bdg_'+k).style.left=pct+'%';
    $('bdg_'+k).textContent = v + (v===1?' day':' days'); });
}
function recordMove(){
  const now=Date.now(), a=state.alloc;
  if (!state.firstMove) state.firstMove=now;
  state.lastMove=now;
  state.moves[state.phase==='decide'?'decide':'explore']++;
  const k=allocKey(a);
  if (!state.explored.has(k)){ state.explored.add(k); state.exploredSeq.push([a.sell,a.help,a.prospect]); }
  state.events.push({ t:now-state.t0, ph:state.phase[0], a:[a.sell,a.help,a.prospect] });
  if (COND.ff==='live' && totalDays()===CFG.TOTAL_DAYS) state.projSeen.add(projStandings().rank);
  update();
}

/* ═══════════════════════════════════════════════════════════════
   8. FLOW: explore → appraisal check → decide → lock → survey
   ═══════════════════════════════════════════════════════════════ */
function update(){
  refreshSliders();
  const t=totalDays(), left=CFG.TOTAL_DAYS-t;
  $('totalUsed').textContent=t;
  $('allocCounter').className='alloc-counter '+(left===0?'complete':'incomplete');
  if (left>0) $('capHint').textContent = `${left} ${left===1?'day':'days'} left to allocate.`;
  else if ($('capHint').textContent.includes('left to allocate')) $('capHint').textContent='';
  renderFF();
  if (COND.ff==='live') renderBoard('projBoard', projStandings().sorted);
  updateButtons();
}
function updateButtons(){
  const full = totalDays()===CFG.TOTAL_DAYS;
  if (state.phase==='explore'){
    const left = Math.max(0, Math.ceil((CFG.MIN_EXPLORE_MS-(Date.now()-state.t0))/1000));
    $('phaseBar').textContent = 'Step 1 of 2 · Explore your options. Try different splits as often as you like.';
    $('continueBtn').disabled = left>0;
    $('continueBtn').textContent = left>0 ? `Continue (available in ${left} s)` : 'Continue →';
  } else if (state.phase==='decide'){
    $('phaseBar').textContent = 'Step 2 of 2 · Make your final decision. Adjust if you wish, then lock it in.';
    $('continueBtn').classList.add('hidden'); $('lockBtn').classList.remove('hidden');
    $('lockBtn').disabled = !full;
    $('lockBtn').textContent = full ? '🔒 Lock final allocation' : `Allocate all ${CFG.TOTAL_DAYS} days to continue`;
  }
}
const shuffle = arr => { for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];} return arr; };
window.openAppraisal = function(){
  if (state.phase!=='explore') return;
  if (!CFG.APPRAISAL_IN_SIM){ enterDecide(); return; }
  state.phase='appraise';
  const items=shuffle([...APPRAISAL_ITEMS]); state.appraisalOrder=items.map(i=>i.id);
