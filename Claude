<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quarterly Effort Planner</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:#d9ece0;min-height:100vh;display:flex;justify-content:center;align-items:center;padding:20px;user-select:none}
.app{max-width:1500px;width:100%;background:#fff;border-radius:32px;box-shadow:0 24px 60px rgba(20,90,42,.15);overflow:hidden}
header{display:flex;justify-content:space-between;align-items:center;padding:16px 26px;border-bottom:1px solid rgba(30,126,52,.12);flex-wrap:wrap;gap:12px}
.logo{display:flex;align-items:center;gap:12px}
.logo-icon{width:38px;height:38px;background:linear-gradient(135deg,#1e7e34,#34a853);border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px}
.logo h1{font-size:17px;font-weight:800;color:#145a2a}
.badge-period{background:#eef6f0;color:#145a2a;font-size:11px;font-weight:700;padding:5px 12px;border-radius:20px;border:1px solid #cfe6d6}
.badge-cell{background:#0f172a;color:#38bdf8;font-size:11px;font-weight:800;padding:5px 12px;border-radius:20px;margin-left:8px;font-family:monospace}
.nav-tabs{display:flex;flex-wrap:wrap;gap:4px;padding:12px 26px 0;border-bottom:1px solid rgba(30,126,52,.08)}
.nav-tab{padding:9px 14px;background:transparent;border:none;border-bottom:2.5px solid transparent;font-family:inherit;font-size:12px;font-weight:700;color:#6f8aa8;cursor:pointer;border-radius:8px 8px 0 0;margin-bottom:-1px}
.nav-tab:hover{color:#145a2a;background:#f4fbf6}
.nav-tab.active{color:#145a2a;border-bottom-color:#1e7e34;background:#f4fbf6}
main{display:grid;grid-template-columns:.85fr 1.2fr .95fr;gap:18px;padding:20px 26px 22px;min-height:600px}
@media (max-width:1200px){main{grid-template-columns:1fr}}
.performance,.leaderboards,.control{background:linear-gradient(165deg,#0a3d33 0%,#155a4a 100%);color:#fff;border-radius:20px;padding:18px;border:1px solid rgba(122,232,210,.15);box-shadow:0 8px 24px rgba(10,61,51,.28);display:flex;flex-direction:column;gap:12px}
.panel-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;display:flex;align-items:center;gap:8px}
.panel-title::after{content:'';flex:1;height:1.5px;background:linear-gradient(90deg,rgba(255,255,255,.28),transparent)}
.card{background:rgba(255,255,255,.08);border-radius:12px;padding:11px 13px;border:1px solid rgba(255,255,255,.12);font-size:11px;line-height:1.6;color:rgba(255,255,255,.92)}
.card h5{font-size:10.5px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;color:#fff}
.rank-card{border-left:4px solid #7ae89a}
.rank-row{display:flex;align-items:baseline;gap:6px}
.rank-value{font-size:26px;font-weight:900}
.rank-of{font-size:12px;font-weight:600;color:rgba(255,255,255,.8)}
.muted{font-size:10px;font-style:italic;color:rgba(255,255,255,.7)}
.plan-row{display:flex;justify-content:space-between;font-family:'SF Mono','Courier New',monospace;font-size:11px;padding:2px 0}
.lb-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.lb-grid.single{grid-template-columns:1fr}
.lb-card{background:rgba(255,255,255,.08);border-radius:12px;padding:10px 12px;border:1px solid rgba(255,255,255,.12)}
.lb-card h4{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;padding-bottom:5px;border-bottom:1px solid rgba(255,255,255,.15);line-height:1.4}
.lb-card h4 small{font-weight:600;text-transform:none;letter-spacing:0;color:rgba(255,255,255,.75)}
.lb-card.proj{border:1.5px dashed rgba(255,217,102,.7)}
.lb-row{display:flex;align-items:center;padding:3px 4px;border-radius:6px;font-size:10.5px;gap:6px}
.lb-row.user{background:rgba(255,217,102,.28);border-left:3px solid #ffd966}
.lb-rank{font-weight:700;color:rgba(255,255,255,.85);min-width:24px;font-size:10px}
.lb-avatar{width:20px;height:20px;border-radius:50%;background:#e2e8f0;overflow:hidden;flex-shrink:0}
.lb-avatar img{width:100%;height:100%;object-fit:cover}
.lb-name{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lb-score{font-weight:700;min-width:26px;text-align:right;font-family:'SF Mono','Courier New',monospace}
.lb-footnote{margin-top:auto;padding:10px 13px;background:rgba(255,255,255,.08);border-radius:12px;border:1px solid rgba(255,255,255,.12);font-size:10.5px;line-height:1.7}
.phase-bar{border-radius:10px;padding:9px 12px;font-size:11px;font-weight:700;background:rgba(255,217,102,.15);border:1px solid rgba(255,217,102,.45);line-height:1.5}
.alloc-counter{border-radius:12px;padding:10px 14px}
.alloc-counter.incomplete{background:rgba(232,93,74,.22);border:1.5px solid rgba(232,93,74,.55)}
.alloc-counter.complete{background:rgba(122,232,154,.18);border:1.5px solid rgba(122,232,154,.55)}
.alloc-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px}
.alloc-value{font-size:22px;font-weight:900;color:#b3ffd1}
.alloc-counter.incomplete .alloc-value{color:#ffc2ad}
.cap-hint{font-size:10px;color:#ffc2ad;min-height:13px;margin-top:2px}
.slider-group{background:rgba(255,255,255,.08);border-radius:12px;padding:10px 13px;border:1px solid rgba(255,255,255,.12)}
.slider-group-label{font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:8px}
.label-icon{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.28);font-size:12px;flex-shrink:0}
.slider-row{display:flex;align-items:center;gap:10px;position:relative;padding-top:28px}
.slider-end-label{font-size:10.5px;font-weight:700;font-family:'SF Mono','Courier New',monospace;min-width:16px}
.slider-track-wrap{position:relative;flex:1;height:24px;cursor:pointer;touch-action:none}
.slider-track-wrap.disabled{cursor:not-allowed;opacity:.6}
.slider-track-bg{position:absolute;top:50%;transform:translateY(-50%);left:0;right:0;height:8px;background:rgba(255,255,255,.2);border-radius:10px}
.slider-track-fill{height:100%;background:linear-gradient(90deg,#7ae89a,#34a853);border-radius:10px}
.slider-thumb{position:absolute;top:50%;left:0;width:22px;height:22px;background:#fff;border:3px solid #1e7e34;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
.slider-badge{position:absolute;bottom:calc(100% + 4px);left:0;transform:translateX(-50%);background:#fff;color:#0a3d1f;font-size:11px;font-weight:900;padding:2px 9px;border-radius:8px;font-family:'SF Mono','Courier New',monospace;border:2px solid #7ae89a;white-space:nowrap}
.ff-box{background:rgba(255,255,255,.06);border:1.5px dashed rgba(255,217,102,.8);border-radius:12px;padding:12px 14px}
.ff-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:#ffd966;margin-bottom:6px}
.ff-rank{display:flex;align-items:baseline;gap:8px;margin:2px 0 6px}
.ff-rank .big{font-size:30px;font-weight:900}
.delta-chip{font-family:'SF Mono',monospace;font-size:10px;font-weight:900;padding:3px 8px;border-radius:6px;margin-left:auto;align-self:center}
.delta-chip.up{background:rgba(122,232,154,.25);color:#b3ffd1}
.delta-chip.down{background:rgba(232,93,74,.25);color:#ffb9a5}
.delta-chip.flat{background:rgba(255,255,255,.1);color:rgba(255,255,255,.75)}
.ff-note{font-size:10.5px;font-style:italic;color:rgba(255,255,255,.8);line-height:1.5}
.btn-stack{margin-top:auto;display:flex;flex-direction:column;gap:8px}
.lock-btn{background:#7ae89a;color:#0a3d1f;border:none;border-radius:30px;padding:12px 18px;font-size:14px;font-weight:800;cursor:pointer;font-family:inherit}
.lock-btn:disabled{opacity:.45;cursor:not-allowed}
.lock-btn.survey{background:#ffd966}
.hidden{display:none !important}
footer{padding:12px 26px;background:#f8fbf9;border-top:1px solid rgba(30,126,52,.08);font-size:10.5px;color:#6f8aa8;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
.modal-overlay{position:fixed;inset:0;background:rgba(10,30,18,.75);backdrop-filter:blur(8px);display:flex;justify-content:center;align-items:center;z-index:1000;opacity:0;visibility:hidden}
.modal-overlay.show{opacity:1;visibility:visible}
.modal-card{background:#fff;border-radius:22px;padding:26px 30px;max-width:560px;width:95%;border:2px solid #1e7e34;max-height:90vh;overflow-y:auto;user-select:text}
.modal-card.wide{max-width:760px}
.modal-card h3{font-size:18px;font-weight:800;color:#145a2a;margin-bottom:10px}
.modal-body{font-size:13px;color:#3d5775;line-height:1.6}
.modal-summary{background:#f4fbf6;border-radius:12px;padding:12px 16px;margin:12px 0;border:1px solid #e8f4ec}
.modal-summary .row{display:flex;justify-content:space-between;padding:3px 0}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:18px}
.modal-btn{padding:11px 22px;border-radius:30px;font-weight:700;font-size:13px;border:none;cursor:pointer;font-family:inherit}
.modal-btn:disabled{opacity:.45;cursor:not-allowed}
.modal-btn-cancel{background:#f0f4fa;color:#3d5775;border:1.5px solid #cddae9}
.modal-btn-confirm{background:linear-gradient(135deg,#1e7e34,#34a853);color:#fff}
.likert-item{padding:10px 0;border-bottom:1px solid #eef2f6}
.likert-text{font-size:13px;color:#1f3b2b;margin-bottom:6px}
.likert-scale{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.likert-scale label{display:flex;flex-direction:column;align-items:center;font-size:11px;color:#3d5775;cursor:pointer;padding:4px;border-radius:8px;border:1px solid #dbe6ef}
.likert-anchors{display:flex;justify-content:space-between;font-size:10px;color:#6f8aa8;margin-top:2px}
.profile-setup{display:flex;gap:20px;align-items:flex-start}
@media (max-width:520px){.profile-setup{flex-direction:column;align-items:center}}
.avatar-preview{width:80px;height:80px;border-radius:50%;background:#e2e8f0;border:3px solid #1e7e34;overflow:hidden;margin:0 auto}
.avatar-preview img{width:100%;height:100%;object-fit:cover}
.avatar-actions{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin-top:8px;max-width:130px}
.avatar-btn{padding:5px 8px;border-radius:20px;border:1px solid #cddae9;background:#f8fafc;font-size:10px;font-weight:700;color:#3d5775;cursor:pointer;font-family:inherit}
.name-inputs{flex:1}
.name-inputs label{font-size:11px;font-weight:800;text-transform:uppercase;color:#5a8a6a;margin-bottom:6px;display:block}
.name-inputs input{width:100%;padding:9px;border-radius:8px;border:1px solid #cddae9;font-family:inherit;font-size:13px;margin-bottom:10px}
#adminDashboard{display:none;position:fixed;inset:0;background:#0f172a;color:#f8fafc;z-index:9999;padding:40px;overflow-y:auto}
#adminDashboard.show{display:block}
.admin-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-top:20px}
.admin-card{background:#1e293b;border-radius:12px;padding:20px;border:1px solid #334155}
.admin-card h3{font-size:13px;color:#94a3b8;text-transform:uppercase;margin-bottom:12px}
.admin-table{width:100%;border-collapse:collapse;font-size:12px}
.admin-table th,.admin-table td{padding:8px;text-align:left;border-bottom:1px solid #334155}
.admin-input{width:100%;padding:10px;border-radius:8px;border:1px solid #475569;background:#0f172a;color:#fff;font-family:monospace;margin-bottom:10px}
#invalidScreen{display:none;padding:60px;text-align:center;color:#145a2a;font-weight:700;background:#fff;border-radius:24px;line-height:1.8}
</style>
</head>
<body>

<!-- ============ RESEARCHER DASHBOARD (local test data only) ============ -->
<div id="adminDashboard">
  <h1 style="font-size:22px;color:#38bdf8;">🔬 Research dashboard (sessions saved in this browser only)</h1>
  <div class="admin-grid">
    <div class="admin-card"><h3>Local sessions</h3><div id="adminTable"></div></div>
    <div class="admin-card"><h3>Inspect a Qualtrics "data" value</h3>
      <textarea id="adminJson" class="admin-input" rows="7" placeholder='{"sid":"...","cell":"live_team",...}'></textarea>
      <button onclick="analyzeJson()" style="padding:10px 20px;background:#38bdf8;border:none;border-radius:8px;font-weight:800;cursor:pointer;">Analyze</button>
      <div id="adminResult" style="margin-top:16px;font-size:12px;line-height:1.8;word-break:break-all;"></div>
    </div>
  </div>
</div>

<div id="invalidScreen">This study link is incomplete. Please go back to the survey and use the link provided there.<br>
<small style="font-weight:500;color:#6f8aa8;">(Researchers: add <code>?preview=1</code> to the URL to preview all six conditions.)</small></div>

<!-- ============ PROFILE SETUP ============ -->
<div class="modal-overlay" id="setupModal">
  <div class="modal-card">
    <h3>👥 Set up your profile</h3>
    <div class="modal-body">
      <div class="profile-setup">
        <div>
          <div class="avatar-preview"><img id="userAvatarImg" alt="Avatar"></div>
          <div class="avatar-actions">
            <button class="avatar-btn" onclick="randomizeAvatar('human')">👨 Human</button>
            <button class="avatar-btn" onclick="randomizeAvatar('animal')">🐶 Animal</button>
            <button class="avatar-btn" onclick="randomizeAvatar('robot')">🤖 Robot</button>
            <button class="avatar-btn" onclick="document.getElementById('avatarUpload').click()">📷 Upload</button>
            <input type="file" id="avatarUpload" accept="image/*" style="display:none" onchange="handleImageUpload(this)">
          </div>
        </div>
        <div class="name-inputs">
          <label>Your name</label>
          <input type="text" id="userName" value="You" maxlength="24">
          <label>A teammate you sometimes help</label>
          <input type="text" id="teammateName" placeholder="e.g., Alex M." maxlength="24">
          <label>Up to 4 other colleagues from your territory</label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <input type="text" id="name1" placeholder="Colleague 1" maxlength="24">
            <input type="text" id="name2" placeholder="Colleague 2" maxlength="24">
            <input type="text" id="name3" placeholder="Colleague 3" maxlength="24">
            <input type="text" id="name4" placeholder="Colleague 4" maxlength="24">
          </div>
        </div>
      </div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn modal-btn-cancel" onclick="skipNames()">Use defaults</button>
      <button class="modal-btn modal-btn-confirm" onclick="saveSetup()">Start →</button>
    </div>
  </div>
</div>

<!-- ============ MAIN APP ============ -->
<div class="app" id="app">
  <header>
    <div class="logo"><div class="logo-icon">📊</div><h1>Quarterly Effort Planner</h1></div>
    <div><span class="badge-period">Q3 · Week 6 of 12 · Plan your next 10 working days</span><span class="badge-cell hidden" id="cellBadge"></span></div>
  </header>
  <div class="nav-tabs hidden" id="navTabs"></div>

  <main>
    <!-- LEFT: identical in all 6 cells except board label/rules -->
    <section class="performance">
      <div class="panel-title">📈 Your standing</div>
      <div class="card rank-card">
        <h5 id="standingHead">Leaderboard</h5>
        <div class="rank-row"><span class="rank-value">#<span id="qtdRank">–</span></span><span class="rank-of">/ <span id="qtdN">–</span></span></div>
        <div class="muted">Quarter-to-date (weeks 1–6)</div>
      </div>
      <div class="card"><h5>🗂️ Company plan for the next 10 days</h5><div id="planBox"></div>
        <div class="muted" style="margin-top:4px">Recommended by your sales manager.</div></div>
      <div class="card"><h5>📐 How days count on this leaderboard</h5><div id="rulesBox"></div></div>
      <div class="card"><h5>💵 Your pay</h5><div id="payBox"></div></div>
    </section>

    <!-- MIDDLE: one board (moderator); projected board only in FF cells (IV) -->
    <section class="leaderboards">
      <div class="panel-title" id="lbTitle">🏆 Leaderboard</div>
      <div class="lb-grid" id="lbGrid">
        <div class="lb-card"><h4 id="qtdHead"></h4><div id="qtdBoard"></div></div>
        <div class="lb-card proj" id="projCard"><h4 id="projHead"></h4><div id="projBoard"></div></div>
      </div>
      <div class="lb-footnote" id="lbFootnote"></div>
    </section>

    <!-- RIGHT: allocation + feedforward widget -->
    <section class="control">
      <div class="panel-title">🕹️ Plan your next 10 days</div>
      <div class="phase-bar" id="phaseBar"></div>
      <div class="alloc-counter complete" id="allocCounter">
        <div class="alloc-label">Allocated</div>
        <div class="alloc-value"><span id="totalUsed">10</span> / 10 days</div>
        <div class="cap-hint" id="capHint"></div>
      </div>
      <div id="sliders" style="display:flex;flex-direction:column;gap:10px"></div>
      <div class="ff-box"><div class="ff-title" id="ffTitle"></div><div id="ffContent"></div></div>
      <div class="btn-stack">
        <button class="lock-btn" id="continueBtn" onclick="openAppraisal()" disabled>Continue</button>
        <button class="lock-btn hidden" id="lockBtn" onclick="openConfirm()">🔒 Lock final allocation</button>
        <button class="lock-btn survey hidden" id="surveyBtn" onclick="goToSurvey()">✅ Continue to the survey →</button>
      </div>
    </section>
  </main>
  <footer><span>Drag the sliders · All 10 days must be allocated</span><span>📊 Interactions are logged confidentially for research.</span></footer>
</div>

<!-- ============ IN-TASK APPRAISAL CHECK (M measured before final Y) ============ -->
<div class="modal-overlay" id="appraisalModal">
  <div class="modal-card wide">
    <h3>📝 Quick check-in</h3>
    <div class="modal-body">
      <p style="margin-bottom:8px">Before you make your final decision, please tell us how you see <b>this quarter's leaderboard situation</b> right now.</p>
      <div id="appraisalItems"></div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn modal-btn-confirm" id="appraisalSubmit" onclick="submitAppraisal()" disabled>Continue to final decision →</button>
    </div>
  </div>
</div>

<!-- ============ CONFIRM ============ -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal-card">
    <h3>🔒 Confirm your final allocation</h3>
    <div class="modal-body">You are about to lock in your plan for the next 10 days. You cannot change it afterwards.
      <div class="modal-summary" id="modalSummary"></div></div>
    <div class="modal-actions">
      <button class="modal-btn modal-btn-cancel" onclick="document.getElementById('confirmModal').classList.remove('show')">← Revise</button>
      <button class="modal-btn modal-btn-confirm" onclick="confirmLock()">Lock it in ✓</button>
    </div>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════════════
   1. CONFIGURATION — edit here
   ═══════════════════════════════════════════════════════════════ */
const CFG = {
  TOTAL_DAYS: 10,
  PLAN: { sell: 6, help: 2, prospect: 2 },        // firm-preferred allocation (Y1 reference)
  QTD_USER_SCORE: 37,                              // quarter-to-date score -> rank #10 of 20
  MIN_EXPLORE_MS: 30000,                           // equal minimum exposure in all cells
  APPRAISAL_IN_SIM: true,                          // false = measure M in Qualtrics instead
  SURVEY_URL: 'https://cityu.qualtrics.com/jfe/form/SV_REPLACE_ME',  // ONE survey for all cells
  LOG_ENDPOINT: null,                              // optional URL to POST the full event log
  ADMIN_PASSWORD: 'change-me'                      // client-side only: NOT real security
};

/* Same scripted peers on BOTH boards → identical standing across moderator levels.
   Entity i has quarter-to-date score QTD[i] and projected end-of-quarter score PROJ[i]. */
const PROJ_PEERS = [96,93,91,88,86,83,81,78,76,73,71,68,65,61,57,52,47,42,36];
const QTD_PEERS  = [48,47,45,44,43,42,40,39,38,36,35,33,31,29,26,24,21,18,15];

/* Score rules, calibrated: plan (6/2/2) → 70 → projected #12 on both boards; best reachable #4 on both. */
const SCORE = {
  ind:  a => 40 + 5 * a.sell,                    // own sales only
  team: a => 50 + 2 * a.sell + 4 * a.help        // team sales; helping a teammate counts double
};

/* ⚠ REPLACE item wording with the exact Searle & Auton (2015) items (4 challenge, 4 hindrance),
   framed to "this quarter's leaderboard situation". Texts below are adapted placeholders for piloting. */
const APPRAISAL_ITEMS = [
  {id:'CH1', text:'This leaderboard situation is an opportunity for me to do well.'},
  {id:'CH2', text:'Dealing with this leaderboard situation will help me grow.'},
  {id:'CH3', text:'This leaderboard situation pushes me to achieve something worthwhile.'},
  {id:'CH4', text:'This leaderboard situation challenges me in a positive way.'},
  {id:'HI1', text:'This leaderboard situation gets in the way of what I want to achieve.'},
  {id:'HI2', text:'This leaderboard situation holds me back from doing my job well.'},
  {id:'HI3', text:'This leaderboard situation is an obstacle I have to deal with.'},
  {id:'HI4', text:'This leaderboard situation keeps me from reaching my goals.'},
  {id:'CP1', text:'I can influence where I end up on this leaderboard.'},
  {id:'CP2', text:'I know what I can do to deal with this leaderboard situation.'}
];

/* ═══════════════════════════════════════════════════════════════
   2. CONDITION ASSIGNMENT  (?ff=none|static|live&board=ind|team)
   ═══════════════════════════════════════════════════════════════ */
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const P = new URLSearchParams(location.search);
const PREVIEW = P.get('preview') === '1';
const FF_LEVELS = ['none','static','live'], BOARD_LEVELS = ['ind','team'];
const ffP = (P.get('ff')||'').toLowerCase(), boardP = (P.get('board')||'').toLowerCase();
const VALID = FF_LEVELS.includes(ffP) && BOARD_LEVELS.includes(boardP);
