const TEAM_NAMES=['Alfa','Beta','Gamma','Delta','Epsilon','Zeta','Eta','Theta','Iota','Kappa','Lambda','Mu','Nu','Xi','Omicron','Pi','Rho','Tau','Upsilon'];
const usedNames = new Set();
function randomName(){
  let n; do { const pool=Math.random()>.5?FIRST_M:FIRST_F;
    n=`${pool[Math.floor(Math.random()*pool.length)]} ${LAST[Math.floor(Math.random()*LAST.length)][0]}.`;
  } while (usedNames.has(n)); usedNames.add(n); return n;
