  PLAN_RANK = projStandings(CFG.PLAN).rank;
  console.assert(PLAN_RANK===12, 'Calibration changed: plan projection is now #'+PLAN_RANK);
  state.explored.add(allocKey(state.alloc)); state.exploredSeq.push([state.alloc.sell,state.alloc.help,state.alloc.prospect]);
  if (COND.ff==='live') state.projSeen.add(PLAN_RANK);
  buildSliders(); renderStaticUI(); update();
  setInterval(()=>{ if (state.phase==='explore') updateButtons(); }, 250);
}

function showAdmin(){
  const pwd=prompt('Researcher password:');
  if (pwd!==CFG.ADMIN_PASSWORD){ alert('Incorrect password.'); location.href=location.pathname; return; }
  $('app').style.display='none'; $('adminDashboard').classList.add('show');
  const data=JSON.parse(localStorage.getItem('effort_sessions_v2')||'[]');
  $('adminTable').innerHTML = !data.length ? '<p style="color:#94a3b8">No local sessions yet.</p>' :
    `<table class="admin-table"><tr><th>SID</th><th>Cell</th><th>S/H/P</th><th>Y1</th><th>Chall.</th><th>Hind.</th><th>Configs</th><th>Total s</th></tr>` +
    data.map(d=>`<tr><td>${esc(d.sid.slice(-6))}</td><td>${esc(d.cell)}</td><td>${d.sell}/${d.help}/${d.prospect}</td><td>${d.y1_dev}</td>
      <td>${d.m_challenge??'–'}</td><td>${d.m_hindrance??'–'}</td><td>${d.n_configs}</td><td>${d.ms_total?Math.round(d.ms_total/1000):'–'}</td></tr>`).join('') + '</table>';
}
window.analyzeJson = function(){
  try { let raw=$('adminJson').value.trim(); if (raw.startsWith('%7B')) raw=decodeURIComponent(raw);
    const d=JSON.parse(raw);
    $('adminResult').innerHTML = Object.entries(d).map(([k,v])=>`<div><b style="color:#38bdf8">${esc(k)}</b>: ${esc(typeof v==='object'?JSON.stringify(v):v)}</div>`).join('');
  } catch(e){ $('adminResult').innerHTML='<p style="color:#ef4444">Invalid JSON.</p>'; }
};

/* Boot */
buildEntities();
randomizeAvatar('human');
if (P.get('role')==='admin') showAdmin();
else if (!VALID && !PREVIEW){ $('app').style.display='none'; $('invalidScreen').style.display='block'; }
else { if (PREVIEW) buildPreviewTabs(); $('setupModal').classList.add('show'); }
</script>
