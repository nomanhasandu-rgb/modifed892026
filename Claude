const userLabel = b => b==='ind' ? `${state.profile.name} (you)` : `Team Sigma — your team (with ${state.profile.teammate})`;
const userAvatar = b => b==='ind' ? state.profile.avatar : 'https://api.dicebear.com/7.x/shapes/svg?seed=Sigma&backgroundColor=c0aede,d1d4f9,b6e3f4';

/* ═══════════════════════════════════════════════════════════════
   5. RANKING
   ═══════════════════════════════════════════════════════════════ */
function standings(board, kind, userScore){
  const ents = board==='ind' ? IND_PEOPLE : TEAMS;
  const all = ents.map(e=>({ name:e.name, avatar:e.avatar, score:e[kind] }));
  all.push({ name:userLabel(board), avatar:userAvatar(board), score:userScore, isUser:true });
  all.sort((a,b)=> (b.score-a.score) || (a.isUser?-1:b.isUser?1:0));
  return { rank: all.findIndex(x=>x.isUser)+1, sorted: all };
}
const projStandings = (a=state.alloc) => standings(COND.board,'proj',SCORE[COND.board](a));
const qtdStandings  = () => standings(COND.board,'qtd',CFG.QTD_USER_SCORE);
function tradeoffKey(){   // true answers for the trade-off-knowledge items (places gained)
  const shift = to => { const a={...CFG.PLAN}; a.prospect--; a[to]++; return PLAN_RANK - projStandings(a).rank; };
  return { tk_sell: shift('sell'), tk_help: shift('help') };
}

