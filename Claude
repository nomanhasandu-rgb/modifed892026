function animalAv(seed){
  const animals=['🐶','🐱','🦊','🐼','🐸','🐧','🦁','🐯','🐮','🐷','🐵','🦄']; let h=0;
  for (let i=0;i<seed.length;i++) h=seed.charCodeAt(i)+((h<<5)-h);
  return `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="%23e2e8f0"/><text x="50" y="50" font-size="60" text-anchor="middle" dominant-baseline="central">${animals[Math.abs(h)%animals.length]}</text></svg>`;
}
