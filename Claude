window.handleImageUpload = function(input){
  if (!input.files || !input.files[0]) return;
  const r = new FileReader();
  r.onload = e => { const img = new Image(); img.onload = () => {
    const c=document.createElement('canvas'), x=c.getContext('2d'), m=Math.min(img.width,img.height);
    c.width=c.height=128; x.drawImage(img,(img.width-m)/2,(img.height-m)/2,m,m,0,0,128,128);
    $('userAvatarImg').src=c.toDataURL('image/jpeg'); }; img.src=e.target.result; };
