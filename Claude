window.confirmLock = function(){
  $('confirmModal').classList.remove('show');
  if (state.phase!=='decide') return;
  state.phase='locked'; state.tLock=Date.now();
  document.querySelectorAll('.slider-track-wrap').forEach(t=>t.classList.add('disabled'));
  $('lockBtn').classList.add('hidden'); $('surveyBtn').classList.remove('hidden');
  $('phaseBar').textContent = '✅ Your allocation is saved. Your final results will be shown at the end of the study.';
  const d = buildPayload();
  try { const s=JSON.parse(localStorage.getItem('effort_sessions_v2')||'[]'); s.push(d); localStorage.setItem('effort_sessions_v2',JSON.stringify(s)); } catch(_){}
  try { if (window.parent!==window) window.parent.postMessage({type:'EFFORT_DATA',data:d},'*'); } catch(_){}
  if (CFG.LOG_ENDPOINT) fetch(CFG.LOG_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...d,events:state.events,exploredSeq:state.exploredSeq}),keepalive:true}).catch(()=>{});
  console.log('EFFORT_DATA', d);
};

function buildPayload(){
  const a=state.alloc, p=CFG.PLAN, ap=state.appraisal, t=state;
  const mean = ids => ids.every(id=>ap[id]!=null) ? +(ids.reduce((s,id)=>s+ap[id],0)/ids.length).toFixed(3) : null;
  return {
    v:'2.0', sid:t.sid, pid:t.pid, ff:COND.ff, board:COND.board, cell:COND.cell,
    sell:a.sell, help:a.help, prospect:a.prospect,
    y1_dev:(Math.abs(a.sell-p.sell)+Math.abs(a.help-p.help)+Math.abs(a.prospect-p.prospect))/2,   // Y1 (0–8 days)
    y2_help:a.help,                                                                                // Y2
    d_sell:a.sell-p.sell, d_help:a.help-p.help, d_prospect:a.prospect-p.prospect,
    alloc_at_m: t.allocAtAppraisal ? [t.allocAtAppraisal.sell,t.allocAtAppraisal.help,t.allocAtAppraisal.prospect] : null,
    m_challenge:mean(['CH1','CH2','CH3','CH4']), m_hindrance:mean(['HI1','HI2','HI3','HI4']), m_coping:mean(['CP1','CP2']),
    items:ap, item_order:t.appraisalOrder,
    qtd_rank:qtdStandings().rank, plan_proj_rank:PLAN_RANK, final_proj_rank:projStandings().rank,
    ...tradeoffKey(),
    ms_explore: t.tAppraisal ? t.tAppraisal-t.t0 : null,
    ms_decide: (t.tLock&&t.tAppraisal) ? t.tLock-t.tAppraisal : null,
    ms_total: t.tLock ? t.tLock-t.t0 : null,
    ms_first_move: t.firstMove ? t.firstMove-t.t0 : null,
    ms_hesitation: (t.tLock&&t.lastMove) ? t.tLock-t.lastMove : null,
    moves_explore:t.moves.explore, moves_decide:t.moves.decide, reversals:t.reversals,
    n_configs:t.explored.size, n_proj_ranks_seen: COND.ff==='live' ? t.projSeen.size : 0,
    custom_names:t.profile.customNames, custom_avatar:(t.profile.avatar||'').startsWith('data:')
  };
}
window.goToSurvey = function(){
  const d=buildPayload();
  const q=new URLSearchParams({ sid:d.sid, ff:d.ff, board:d.board, cell:d.cell, y1:d.y1_dev, y2:d.y2_help,
    tk_sell:d.tk_sell, tk_help:d.tk_help, data:JSON.stringify(d) });
  if (d.pid) q.set('pid', d.pid);
  location.href = CFG.SURVEY_URL + (CFG.SURVEY_URL.includes('?')?'&':'?') + q.toString();
